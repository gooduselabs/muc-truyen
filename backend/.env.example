DATABASE_URL=postgresql://story:story@localhost:5432/story
JWT_SECRET=change-me
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Payments: sandbox is on by default. Fill these to enable real gateways (not tested in v0.1).
PAYMENTS_SANDBOX=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Storage: local ./uploads by default; set S3_BUCKET to use S3/R2/MinIO.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
